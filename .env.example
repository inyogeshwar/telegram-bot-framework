# Telegram Bot Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Required: Your bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Optional: Webhook configuration
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET=your_webhook_secret_here

# Optional: Admin user IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Optional: Database configuration
DATABASE_URL=postgresql://user:password@localhost:5432/bot_db

# Optional: Redis configuration
REDIS_URL=redis://:password@localhost:6379/0

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional: Bot features
ENABLE_WEBHOOK=false
ENABLE_JOB_QUEUE=true
ENABLE_PERSISTENCE=true

# Optional: AI integration (for AI chatbot example)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Payment provider token (from @BotFather)
PAYMENT_PROVIDER_TOKEN=your_payment_provider_token_here
