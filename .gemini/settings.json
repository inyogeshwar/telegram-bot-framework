{
  "context": {
    "fileName": ["GEMINI.md", "AGENTS.md", "CLAUDE.md"]
  },
  "theme": {
    "color": {
      "background": "#000000",
      "foreground": "#FFFFFF",
      "accent": "#4CAF50"
    }
  },
  "permissions": {
    "allow": [
      "bash(python *)",
      "bash(pip install *)",
      "bash(pytest *)",
      "bash(ruff *)",
      "bash(mypy *)"
    ],
    "deny": [
      "bash(rm -rf /)",
      "bash(git push --force *)"
    ]
  }
}
