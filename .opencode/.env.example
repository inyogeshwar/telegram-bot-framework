# OpenCode Environment Configuration
# Copy this file to .env and fill in your values

# Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# GitHub Integration
GITHUB_TOKEN=

# OpenCode Settings
OPENCODE_AUTO_SHARE=false
OPENCODE_DISABLE_AUTOUPDATE=false
OPENCODE_DISABLE_PRUNE=false
OPENCODE_DISABLE_TERMINAL_TITLE=false
OPENCODE_PERMISSION=
OPENCODE_DISABLE_DEFAULT_PLUGINS=false
OPENCODE_DISABLE_LSP_DOWNLOAD=false
OPENCODE_ENABLE_EXPERIMENTAL_MODELS=false
OPENCODE_DISABLE_AUTOCOMPACT=false
OPENCODE_DISABLE_CLAUDE_CODE=false
OPENCODE_DISABLE_CLAUDE_CODE_PROMPT=false
OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=false
OPENCODE_DISABLE_MODELS_FETCH=false
OPENCODE_DISABLE_MOUSE=false

# Server Settings (for serve/web commands)
OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_USERNAME=opencode

# Experimental Features
OPENCODE_EXPERIMENTAL=false
OPENCODE_EXPERIMENTAL_ICON_DISCOVERY=false
OPENCODE_EXPERIMENTAL_DISABLE_COPY_ON_SELECT=false
OPENCODE_EXPERIMENTAL_BASH_DEFAULT_TIMEOUT_MS=120000
OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX=16384
OPENCODE_EXPERIMENTAL_FILEWATCHER=false
OPENCODE_EXPERIMENTAL_OXFMT=false
OPENCODE_EXPERIMENTAL_LSP_TOOL=false
OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER=false
OPENCODE_EXPERIMENTAL_EXA=false
OPENCODE_EXPERIMENTAL_LSP_TY=false
OPENCODE_EXPERIMENTAL_PLAN_MODE=false
OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=false
OPENCODE_EXPERIMENTAL_EVENT_SYSTEM=false
OPENCODE_EXPERIMENTAL_NATIVE_LLM=false
OPENCODE_EXPERIMENTAL_PARALLEL=false
OPENCODE_EXPERIMENTAL_SCOUT=false
OPENCODE_EXPERIMENTAL_WORKSPACES=false

# Web Search
OPENCODE_ENABLE_EXA=false

# Windows Specific
OPENCODE_GIT_BASH_PATH=
